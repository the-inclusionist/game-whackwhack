{
  "name": "@the-inclusionist/game-whackwhack",
  "version": "0.1.0",
  "type": "module",
  "description": "A whack-a-mole where the child collects what is CORRECT among the lit tiles, drawn with Zdog on the Inclusionist accessibility engine. Reimplemented from the rules of si-em/whackwhack.",
  "license": "AGPL-3.0-or-later",
  "exports": {
    ".": {
      "types": "./dist-lib/types/index.d.ts",
      "default": "./dist-lib/index.js"
    },
    "./style.css": "./app/css/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist-lib",
    "app/css/style.css",
    "LICENSE",
    "README.md",
    "docs/LICENSES.md",
    "docs/CREDITS.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build && tsc -p tsconfig.pkg.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:a11y": "vitest run --project browser tests/a11y.browser.test.ts && node tests/axe-url.mjs",
    "validate": "npm run typecheck && vitest run && vite build && npm run build:lib",
    "prepack": "npm run build:lib"
  },
  "devDependencies": {
    "@the-inclusionist/engine": "9.0.0",
    "@types/node": "^22.0.0",
    "@vitest/browser": "^4.0.0",
    "@vitest/browser-playwright": "^4.0.0",
    "axe-core": "^4.13.0",
    "playwright": "^1.49.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "zdog": "^1.1.3"
  },
  "peerDependencies": {
    "@the-inclusionist/engine": "9.0.0",
    "zdog": "^1.1.3"
  }
}
